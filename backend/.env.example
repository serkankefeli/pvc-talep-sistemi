APP_NAME=PVC Teklif Talep API
ENVIRONMENT=development
DEBUG=false
ENABLE_DOCS=true

# Development:
DATABASE_URL=sqlite:///./pvc_requests.db
# Production example:
# DATABASE_URL=postgresql+psycopg://pvc_user:strong-password@db:5432/pvc_quotes

# Exact, comma-separated Angular origins. Never use *.
CORS_ORIGINS=http://localhost:4200

ADMIN_USERNAME=admin
# Generate this Argon2 hash as described in README.md.
ADMIN_PASSWORD_HASH=
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
JWT_ALGORITHM=HS256
JWT_ISSUER=pvc-quote-api
JWT_EXPIRE_MINUTES=15

PUBLIC_RATE_LIMIT_REQUESTS=10
PUBLIC_RATE_LIMIT_WINDOW_SECONDS=60
AUTH_RATE_LIMIT_REQUESTS=10
AUTH_RATE_LIMIT_WINDOW_SECONDS=300
MAX_REQUEST_BODY_BYTES=131072
MAX_BRANDING_LOGO_BYTES=2097152
BRANDING_UPLOAD_DIR=uploads/branding

# If SMTP is absent, the API remains available and logs only the random request
# reference. Customer e-mail actions return 503 instead of pretending to send.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_ADMIN_EMAIL=
SMTP_STARTTLS=true
SMTP_TIMEOUT_SECONDS=10
ADMIN_PANEL_BASE_URL=http://localhost:4200/admin
