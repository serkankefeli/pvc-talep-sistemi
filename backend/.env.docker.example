# Copy this file to .env.docker and generate the Argon2 hash as described in
# backend/README.md. Never write the plain-text admin password here.
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=''

# Keep disabled for the existing single-company installation.
# Provision the registry first; activation steps are in docs/SAAS.md.
SAAS_ENABLED=false
SAAS_MANIFEST_PATH=/data/tenants.json
SAAS_UPLOAD_ROOT=/data/uploads/tenants

