# Kok dizindeki .env icin ornek. Sunucuda `.env` olarak kopyalanir.
# Bu dosya yalniz Compose interpolasyonu icindir; uygulama sirlari
# backend/.env ve backend/.env.docker dosyalarinda durur.

# Uygulamanin yayinlandigi tam adres. Sonunda / olmaz.
# CORS_ORIGINS ve ADMIN_PANEL_BASE_URL bu degerden turetilir.
PVC_PUBLIC_URL=https://teklif.sunyapi.com

# Web container'inin host uzerinde dinledigi loopback portu.
# Host nginx bu porta proxy yapar. Sunucuda bos oldugunu dogrulayin.
PVC_WEB_PORT=4310

# Compose agi. Sunucudaki diger projelerin aglariyla cakismamali.
# Bu deger ayni zamanda uvicorn'un guvendigi proxy araligidir.
PVC_NETWORK_SUBNET=172.31.240.0/24

# PostgreSQL. Parolayi `openssl rand -base64 36` ile uretin.
POSTGRES_DB=pvc_quotes
POSTGRES_USER=pvc_user
POSTGRES_PASSWORD=
